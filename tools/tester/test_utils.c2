module test_utils;

import ctype local;
import stdarg local;
import stdio local;

import color local;
import string_buffer;

public bool color_output;
const char* proc_name = "";

public Color colError = Bred;
public Color colSkip  = Bcyan;
public Color colOk    = Green;
public Color colDebug = Bmagenta;

public fn void set_color_output(const char* name, bool enable) {
    proc_name = name;
    color_output = enable;
}

public fn void color_print(Color col, const char* format @(printf_format), ...) {
    char[1024] buffer;
    va_list args;
    va_start(args, format);
    vsnprintf(buffer, elemsof(buffer), format, args);
    va_end(args);

    if (color_output) printf("%s%s%s\n", col.str(), buffer, color.Normal.str());
    else printf("%s\n", buffer);
}

public fn void print_error(const char* format @(printf_format), ...) {
    char[1024] buffer;
    va_list args;
    va_start(args, format);
    vsnprintf(buffer, elemsof(buffer), format, args);
    va_end(args);

    if (color_output) fprintf(stderr, "%s: %s%s%s\n", proc_name, color.Byellow.str(), buffer, color.Normal.str());
    else fprintf(stderr, "%s: %s\n", proc_name, buffer);
}

public fn void color_print2(string_buffer.Buf* output,
                            Color col,
                            const char* format @(printf_format),
                            ...)
{
    output.color(col);
    va_list args;
    va_start(args, format);
    output.vprintf(format, args);
    va_end(args);
    output.color(Normal);
    output.newline();
}

public fn const char* skipBlanks(const char* cp) {
    while (isblank(*cp)) cp++;
    return cp;
}

public fn const char* lineEnd(const char* cp) {
    while (*cp && *cp != '\n') cp++;
    return cp;
}

public fn const char* trimTrailingBlanks(const char* start, const char* cp) {
    while (cp > start && isblank(cp[-1])) cp--;
    return cp;
}

public fn bool strstart(const char* p, const char* s, const char** pp = nil) {
    while (*s) {
        if (*p++ != *s++) return false;
    }
    if (pp) *pp = p;
    return true;
}
