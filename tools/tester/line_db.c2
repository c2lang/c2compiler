module line_db;

import stdlib { calloc, malloc, free }
import string { memcpy, strndup }

type Entry struct {
    char* line;
    bool consecutive;
}

public type LineDb struct @(opaque) {
    u32 count;
    u32 capacity;
    // TODO use vector<Entry>
    Entry* entries;
}

public fn LineDb* LineDb.create() {
    LineDb* db = calloc(1, sizeof(LineDb));
    return db;
}

public fn void LineDb.destroy(LineDb* db) {
    for (u32 i=0; i<db.count; i++) {
        free(db.entries[i].line);
    }
    free(db.entries);
    free(db);
}

public fn u32 LineDb.size(const LineDb* db) {
    return db.count;
}

fn void LineDb.resize(LineDb* db, u32 capacity) {
    Entry* entries2 = malloc(capacity * sizeof(Entry));
    if (db.count) {
        memcpy(entries2, db.entries, db.count * sizeof(Entry));
        free(db.entries);
    }
    db.capacity = capacity;
    db.entries = entries2;
}

public fn void LineDb.add(LineDb* db, const char* start, const char* end, bool consecutive) {
    if (db.count == db.capacity) {
        db.resize(db.capacity ? db.capacity * 2 : 4);
    }
    Entry* entry = &db.entries[db.count];
    db.count++;

    entry.line = strndup(start, (usize)(end - start));
    entry.consecutive = consecutive;
}

public fn const char* LineDb.getLine(const LineDb* db, u32 idx) {
    return db.entries[idx].line;
}

public fn bool LineDb.getConsecutive(const LineDb* db, u32 idx) {
    return db.entries[idx].consecutive;
}

