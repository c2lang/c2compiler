public const u32 MAX_LINE = 512;

// TODO move to libc (now supported)
fn bool doWIFEXITED(i32 state) {
    return ((state & 0xff) == 0);
}

fn char getWEXITSTATUS(i32 state) {
    return (char)((state >> 8) & 0xff);
}


public type TestKind enum u8 (public const char* const ext) {
    None : { "" },
    C2   : { ".c2" },
    C2T  : { ".c2t" },
    C2A  : { ".c2a" },
}

public type Db struct {
    string_buffer.Buf* output;  // no ownership
    const char* source;     // no ownership
    const char* filename;   // no ownership
    TestKind kind;
    const char* tmp_dir;
    const char* c2c_cmd;    // no ownership

    // TODO use vector<ExpectFile>
    ExpectFile** expectedFiles;
    u32 expectedCount;
    u32 expectedCapacity;

    Issues* errors;
    Issues* warnings;
    Issues* notes;

    bool hasErrors;
    bool skip;
    bool runSkipped;        // TODO pass from init
    const char* bol;    // pointer inside source to the beginning of the current line
    const char* cur;    // pointer inside source to the current byte
    u32 line_nr;        // line number, updated by db.skipLine()
    string_buffer.Buf* recipe;      // ownership
    char[file_utils.Max_path] current_file;
    char[64] target;

    char[32] word_buffer;
    char[MAX_LINE] line_buffer;
}

public fn void Db.init(Db* db,
                         string_buffer.Buf* output,
                         const char* source,
                         const char* filename,
                         TestKind kind,
                         const char* tmp_dir,
                         const char* c2c_cmd,
                         const char* cwd,
                         bool runSkipped)
{
    memset(db, 0, sizeof(Db));
    db.output = output;
    db.source = source;
    db.filename = filename;
    db.kind = kind;
    db.tmp_dir = tmp_dir;
    db.c2c_cmd = c2c_cmd;
    db.runSkipped = runSkipped;

    db.errors = issues.create("error");
    db.warnings = issues.create("warning");
    db.notes = issues.create("note");

    db.line_nr = 1;
    db.bol = source;
    db.cur = source;
    db.recipe = string_buffer.create(4096, false, 2);

    if (kind == C2) { // only for single file test
        file_utils.make_path(db.current_file, elemsof(db.current_file), cwd, filename);
    }
}

public fn void Db.destroy(Db* db) {

    for (u32 i=0; i<db.expectedCount; i++) {
        db.expectedFiles[i].destroy();
    }
    free(db.expectedFiles);
    db.recipe.free();
    db.notes.destroy();
    db.warnings.destroy();
    db.errors.destroy();
}

public fn Issues* Db.getIssues(const Db* db, const char* name, bool* add) {
    switch (name) {
    case "error32":
        *add = (sizeof(void*) == 4);
        return db.errors;
    case "error64":
        *add = (sizeof(void*) == 8);
        return db.errors;
    case "error":
        *add = true;
        return db.errors;
    case "warning32":
        *add = (sizeof(void*) == 4);
        return db.warnings;
    case "warning64":
        *add = (sizeof(void*) == 8);
        return db.warnings;
    case "warning":
        *add = true;
        return db.warnings;
    case "note32":
        *add = (sizeof(void*) == 4);
        return db.notes;
    case "note64":
        *add = (sizeof(void*) == 8);
        return db.notes;
    case "note":
        *add = true;
        return db.notes;
    default:
        *add = false;
        return nil;
    }
}

public fn bool Db.haveErrors(const Db* db) {
    return db.hasErrors;
}

fn void Db.addExpected(Db* db, ExpectFile* f) {
    if (db.expectedCount == db.expectedCapacity) {
        db.expectedCapacity += 4;
        ExpectFile** exp2 = malloc(db.expectedCapacity * sizeof(ExpectFile*));
        if (db.expectedFiles) {
            memcpy(exp2, db.expectedFiles, db.expectedCount * sizeof(ExpectFile*));
            free(db.expectedFiles);
        }
        db.expectedFiles = exp2;
    }

    db.expectedFiles[db.expectedCount] = f;
    db.expectedCount++;
}

fn void Db.writeFile(Db* db, const char* filename, const char* data, u32 len) {
    file_utils.File file.init(db.tmp_dir, filename);
    if (!file.write(data, len)) {
        print_error("error writing %s: %s", file.path, file.getError());
        exit(EXIT_FAILURE);
    }
}

fn void Db.skipLine(Db* db) {
    const char* cp = db.cur;
    if (*cp) {
        while (*cp && *cp++ != '\n') continue;
        db.bol = db.cur = cp;
        db.line_nr++;
    }
}

fn bool Db.match(Db* db, const char* s) {
    const char* cp = db.cur;
    while (*s) {
        if (*cp++ != *s++) return false;
    }
    db.cur = cp;
    return true;
}

fn const char* Db.readWord(Db* db) {
    const char* cp = db.cur;
    while (isalnum(*cp) || *cp == '-' || *cp == '_') cp++;
    // silently truncate overlong words
    u32 len = (u32)(cp - db.cur);
    if (len >= elemsof(db.word_buffer))
        len = elemsof(db.word_buffer) - 1;
    memcpy(db.word_buffer, db.cur, len);
    db.word_buffer[len] = 0;
    db.cur = cp;
    return db.word_buffer;
}

fn const char* Db.readLine(Db* db) {
    const char* cp = db.cur;
    while (*cp && *cp != '\n') cp++;
    u32 len = (u32)(cp - db.cur);
    // silently truncate overlong lines
    if (len >= elemsof(db.line_buffer))
        len = elemsof(db.line_buffer) - 1;
    memcpy(db.line_buffer, db.cur, len);
    db.line_buffer[len] = 0;
    db.cur = cp;
    return db.line_buffer;
}

fn bool Db.readArgument(Db* db, char* dst, u32 size, const char* item) {
    // extract a string between {} to a buffer
    // stop on newline and end of file
    // return true on success, show error message and return false on error

    const char* cp = db.cur;
    u32 len = 0;
    if (*cp++ != '{') {
        return db.error("missing '{' for %s argument", item);
    }
    while (1) {
        if (*cp == 0 || *cp == '\n') {
            return db.error("missing '}'");
        }
        if (*cp == '}') {
            dst[len] = '\0';
            db.cur = cp + 1;
            return true;
        }
        if (len + 2 >= size) {
            return db.error("%s argument too long", item);
        }
        dst[len++] = *cp++;
    }
}

fn bool Db.parseRecipe(Db* db) {
    db.cur = skipBlanks(db.cur);
    const char* target = db.readWord();
    switch (target) {
    case "bin":
        db.recipe.add("executable test\n");
        break;
    case "lib":   // Syntax lib dynamic/static/source
        db.cur = skipBlanks(db.cur);
        const char* libtype = db.readWord();
        switch (libtype) {
        case "dynamic":
        case "static":
        case "source":
            db.recipe.print("lib test %s\n", libtype);
            break;
        default:
            return db.error("unknown library type '%s'", libtype);
        }
        break;
    default:
        return db.error("unknown target type '%s'", target);
    }
    db.skipLine();
    // TODO check that each line starts with $? (after optional whitespace)
    while (*db.cur && !strstart(db.cur, "// @")) {
        if (*db.cur != '\n') {
            db.recipe.add(db.readLine());
            db.recipe.newline();
        }
        db.skipLine();
    }
    return true;
}

fn bool Db.parseFile(Db* db) {
    // Syntax file{name}
    char[128] filename;
    if (!db.readArgument(filename, elemsof(filename), "filename"))
        return false;
    if (*filename == 0) {
        return db.error("expected filename");
    }
    if (!endsWith(filename, ".c2"))
        pstrcat(filename, elemsof(filename), ".c2");
    db.recipe.print("    %s\n", filename);
    u32 line_offset = db.line_nr;
    db.skipLine();
    const char* start = db.cur;
    while (*db.cur && !strstart(db.cur, "// @")) {
        db.parseTags(filename, db.line_nr - line_offset);
        db.skipLine();
    }
    db.writeFile(filename, start, (u32)(db.cur - start));
    return true;
}

fn bool Db.parseExpect(Db* db, bool add) {
    char[128] args;
    // Syntax expect{mode, name}
    if (!db.readArgument(args, elemsof(args), "expect"))
        return false;

    const char* mode = args;
    char* p = strchr(args, ',');
    if (!p) return db.error("expected 2 arguments");
    *p = '\0';
    const char* filename = skipBlanks(p + 1);

    ExpectMode em;
    switch (mode) {
    case "atleast":
        em = ATLEAST;
        break;
    case "complete":
        em = COMPLETE;
        break;
    default:
        return db.error("unknown mode: %s", mode);
    }
    if (*filename == 0) {
        return db.error("expected filename");
    }
    db.skipLine();

    ExpectFile* currentExpect = nil;
    if (add) {
        // TODO check for name duplicates
        currentExpect = expect_file.create(filename, em);
        db.addExpected(currentExpect);
    }
    while (*db.cur && !strstart(db.cur, "// @")) {
        if (add) currentExpect.addLine(db.line_nr, db.cur, lineEnd(db.cur));
        db.skipLine();
    }
    return true;
}

fn bool Db.checkKind(Db* db, const char* keyword, TestKind k1, TestKind k2 = None) {
    if (k1 == db.kind || k2 == db.kind) return true;
    char[80] buf;
    usize pos = pstrcpy(buf, elemsof(buf), k1.ext);
    if (k2) snprintf(buf + pos, elemsof(buf) - pos, "/%s", k2.ext);
    return db.error("keyword '%s' only allowed in %s files", keyword, buf);
}

fn bool Db.parseKeyword(Db* db) {
    // NOTE: cur points to start of keyword after // @
    bool add = true;
    const char* keyword = db.readWord();
    switch (keyword) {
    case "skip":
        if (!db.runSkipped) db.skip = true;
        db.skipLine();
        return true;
    case "recipe":
        if (!db.checkKind(keyword, C2T)) return false;
        return db.parseRecipe();
    case "warnings":
        if (!db.checkKind(keyword, C2)) return false;
        char[128] list;
        if (!db.readArgument(list, elemsof(list), "list"))
            return false;
        db.recipe.print("  $warnings %s\n", list);
        db.skipLine();
        return true;
    case "target":
        if (!db.checkKind(keyword, C2)) return false;
        if (!db.readArgument(db.target, elemsof(db.target), "target"))
            return false;
        if (*db.target == 0) {
            return db.error("expected target triple");
        }
        string_buffer.Buf* build = string_buffer.create(1024, false, 0);
        build.print("target: \"%s\"\n", db.target);
        build.add("libdir:\n");
        build.add("   - \"$C2_LIBDIR\"\n");
        db.writeFile(constants.buildfile_name, build.data(), build.size());
        build.free();
        db.skipLine();
        return true;
    case "file":
        if (!db.checkKind(keyword, C2T, C2A)) return false;
        return db.parseFile();
    case "expect32":
        add = (sizeof(void*) == 4);
        goto expect;
    case "expect64":
        add = (sizeof(void*) == 8);
        goto expect;
    case "expect":
    expect:
        if (!db.checkKind(keyword, C2T, C2A)) return false;
        return db.parseExpect(add);
    case "error":
    case "error32":
    case "error64":
    case "warning":
    case "warning32":
    case "warning64":
    case "note":
    case "note32":
    case "note64":
        if (!db.checkKind(keyword, C2)) return false;
        db.cur = db.bol;
        db.parseTags(db.current_file, db.line_nr);
        db.skipLine();
        return true;
    default:
        return db.error("unknown keyword '%s'", keyword);
    }
}

fn bool Db.parseOuter(Db* db) {
    // scan every line of the input file for directives and tags
    while (*db.cur) {
        // lines starting with '// @' are directives
        if (db.match("// @")) {
            if (db.parseKeyword()) continue;
            return false;   // error already output
        }
        if (db.kind == C2) {
            db.parseTags(db.current_file, db.line_nr);
        } else {
            // in .c2t/.cta, only accept directives or comments
            db.cur = skipBlanks(db.cur);
            if (*db.cur && *db.cur != '\n' && !strstart(db.cur, "//")) {
                return db.error("unexpected line");
            }
        }
        db.skipLine();
    }
    return true;
}

// format error message to Db.output, set Db.hasErrors return false
fn bool Db.error(Db* db, const char* format @(printf_format), ...) {
    char[1024] msg;
    va_list args;
    va_start(args, format);
    vsnprintf(msg, elemsof(msg), format, args);
    va_end(args);
    color_print2(db.output, colError, "%s:%d: %s", db.filename, db.line_nr, msg);
    db.hasErrors = true;
    return false;
}

fn void Db.parseTags(Db* db, const char* filename, u32 line_nr) {
    // scan for '// @' or '/* @' anywhere: must be a note/warning/error
    for (const char* cp = db.cur;; cp++) {
        if (*cp == '\0' || *cp == '\n') {
            db.cur = cp;
            return;
        }
        if (*cp == '/' && (strstart(cp, "// @", &db.cur) || strstart(cp, "/* @", &db.cur)))
            break;
    }

    const char* tag = db.readWord();
    bool add;
    Issues* ip = db.getIssues(tag, &add);
    if (!ip) {
        db.error("unknown tag '%s', expected note/warning/error", tag);
        return;
    }

    char[128] msg;
    if (!db.readArgument(msg, elemsof(msg), "message"))
        return;

    // adjust line number for some special cases
    // syntax: '// @error{message} +1' specifies an error on the next line
    const char* p = skipBlanks(db.cur);
    if (*p && *p != '\n') line_nr += atoi(p);
    if (add) {
#if TesterDebug
        color_print(color.Blue, "  expecting %s '%s' at %s:%d", ip.name, msg, filename, line_nr);
#endif
        ip.add(filename, line_nr, msg);
    }
}

public fn bool Db.parse(Db* db) {
    bool hasSkip = strstart(db.cur, "// @skip");
    if (db.runSkipped != hasSkip) {
        db.skip = true;
        return true;
    }

    switch (db.kind) {
    case C2:
        db.recipe.add("executable test\n");
        db.recipe.add("  $warnings unreachable-code\n");
        db.recipe.add("  $warnings no-unused-module\n");
        db.recipe.add("  $backend c\n");
        // parse file to generate extra options before the file name
        if (!db.parseOuter()) return false;
        // output the full pathname as c2c will be run from the tmp dir
        db.recipe.print("  %s\n", db.current_file);
        db.recipe.add("end\n");
        db.writeFile("recipe.txt", db.recipe.data(), db.recipe.size());
        break;
    case C2T:
        if (!db.parseOuter()) return false;
        db.recipe.add("end\n");
        db.writeFile("recipe.txt", db.recipe.data(), db.recipe.size());
        break;
    case C2A:
        db.recipe.add("executable test\n");
        db.recipe.add("  $warnings unreachable-code\n");
        db.recipe.add("  $warnings no-unused\n");
        db.recipe.add("  $backend c skip\n");
        db.recipe.add("  $write-AST\n");
        if (!db.parseOuter()) return false;
        db.recipe.add("end\n");
        db.writeFile("recipe.txt", db.recipe.data(), db.recipe.size());
        break;
    default:
        return db.error("unsupported test kind");
    }

    return db.skip;
}

public fn void Db.testFile(Db* db) {
    // flush all streams before forking to avoid duplicate output
    fflush(nil);

    i32[2] pipe_stdout;
    if (pipe(pipe_stdout) == -1) {
        fprintf(stderr, "pipe() failed: %s\n", strerror(errno));
        exit(1);
    }
    i32[2] pipe_stderr;
    if (pipe(pipe_stderr) == -1) {
        fprintf(stderr, "pipe() failed: %s\n", strerror(errno));
        exit(1);
    }

    // spawn a child to run c2c
    pid_t pid = fork();
    if (pid == -1) {
        fprintf(stderr, "fork() failed: %s\n", strerror(errno));
        exit(1);
    }
    if (pid==0) { // child
        while ((dup2(pipe_stdout[1], STDOUT_FILENO) == -1) && (errno == EINTR)) {}
        close(pipe_stdout[1]);
        close(pipe_stdout[0]);
        while ((dup2(pipe_stderr[1], STDERR_FILENO) == -1) && (errno == EINTR)) {}
        close(pipe_stderr[1]);
        close(pipe_stderr[0]);
        execl(db.c2c_cmd, "c2c", "-d", db.tmp_dir, "--test", nil);
        fprintf(stderr, "execl() failed: %s\n", strerror(errno));
        exit(127); /* only if execv fails */
    } else { // parent
        close(pipe_stdout[1]);
        close(pipe_stderr[1]);

        // collect output and check errors
        string_buffer.Buf* buf = string_buffer.create(4096, false, 2);
        for (;;) {
            char[64*1024] buffer;
            isize count = read(pipe_stderr[0], buffer, sizeof(buffer));
            if (count == -1) {
                if (errno == EINTR) continue;
                perror("read");
                exit(1);
            }
            if (count == 0) break;
            buf.add2(buffer, (u32)count);
        }
        db.checkErrors(buf.data(), buf.size());
        buf.free();

        i32 status = 0;
        waitpid(pid, &status, 0);

        if (!doWIFEXITED(status)) {  // child exited abnormally
            // TODO print pipe_stderr
            color_print2(db.output, colError, "c2c crashed!");
            db.hasErrors = true;
            return;
        }
        // check return code
        i32 retcode = getWEXITSTATUS(status);
        if (retcode == 127) {
            //color_print2(db.output, colError, "Error spawning compiler '%s'", db.c2c_cmd);
            color_print(colError, "Error spawning compiler '%s'", db.c2c_cmd);
            exit(EXIT_FAILURE);
        }
        if (retcode == 254) { // from TODO/FATAL_ERROR macros
            color_print2(db.output, colError, "c2c returned error 254");
            db.hasErrors = true;
            return;
        }
        close(pipe_stdout[0]);
        close(pipe_stderr[0]);
        wait(nil);
        if (retcode == 1) {
            // recipe error and such
            color_print2(db.output, colError, "c2c returned exit status %d", retcode);
            db.hasErrors = true;
        } else {
            db.checkExpectedFiles();
            if (!db.errors.allFound() || !db.warnings.allFound()) db.hasErrors = true;
        }
    }
}

fn void Db.checkDiagnosticLine(Db* db, const char* line) {
#if TesterDebug
    color_print(color.White, "line: '%s'", line);
#endif
    // line syntax: '<filename>.c2:<linenr>:<colnr>: error/warning/note: <msg>\n'
    char[128] filename_full;
    char[128] msg;
    char[8] tag;
    u32 error_line;
    u32 col;

    if (sscanf(line, "%127[^: \n]:%u:%u: %7[a-z]: %127[^\n]", filename_full, &error_line, &col, tag, msg) != 5)
        return;

    // remove '/tmp/testerX' prefix if present for error matching
    const char* filename = filename_full;
    const char* p;
    if (strstart(filename, db.tmp_dir, &p) && *p == '/') {
        filename = p + 1;
    }

    bool add;
    if (Issues* ip = db.getIssues(tag, &add)) {
#if TesterDebug
        color_print(color.Cyan, "%s:%d:%d: %s '%s'", filename, error_line, col, tag, msg);
#endif
        db.matchIssues(ip, filename, error_line, msg);
    } else {
        // report unexpected tag?
    }
}

fn void Db.checkErrors(Db* db, const char* buffer, u32 size) {
#if TesterDebug
    color_print(color.Magenta, "stderr:\n%s", buffer);
#endif
    const char* cp = buffer;
    const char* end = cp + size;
    const char* line = cp;
    bool haveColon = false;
    while (cp != end) {
        // cut up into lines
        if (*cp == ':') haveColon = true;
        if (*cp == '\n') {
            if (haveColon) {
                char[512] data;
                u32 len = (u32)(cp - line);
                assert(len < sizeof(data));
                memcpy(data, line, len);
                data[len] = 0;
                db.checkDiagnosticLine(data);
                haveColon = false;
            }
            cp++;
            line = cp;
        } else {
            cp++;
        }
    }
}

fn void Db.checkExpectedFiles(Db* db) {
    char[file_utils.Max_path] basedir;
    file_utils.make_path(basedir, elemsof(basedir), db.tmp_dir, "output/test/");
    for (u32 i=0; i<db.expectedCount; ++i) {
        ExpectFile* e = db.expectedFiles[i];
        if (!e.check(db.output, basedir)) db.hasErrors = true;
    }
}

fn const char* relativeFilename(const char* name) {
    char[file_utils.Max_path] buffer;
    char* cwd = unistd.getcwd(buffer, sizeof(buffer));
    if (cwd) {
        usize len = strlen(cwd);
        if (len > 1 && !strncmp(name, cwd, len) && name[len] == '/' && name[len + 1] != '\0')
            return name + len + 1;
    }
    return name;
}

fn const char* Db.getShowName(Db* db, char* path, usize path_size, const char* filename) {
    const char* show_filename;
    if (*filename != '/') {
        // filename is in the tmp directory: report full path in errors
        file_utils.make_path(path, path_size, db.tmp_dir, filename);
        return path;
    } else {
        // otherwise report error with filename relative to current directory
        return relativeFilename(filename);
    }
}

fn void Db.matchIssues(Db* db, Issues* ip, const char* filename, u32 linenr, const char* msg) {
    char[128] path;
    const char* show_filename = db.getShowName(path, elemsof(path), filename);

    Iter iter = ip.getIter();
    if (iter.find(filename, linenr)) {
        // TODO should accept multiple issues on the same line
        const char* match = iter.getMsg();
        if (iter.getFound()) {
            color_print2(db.output, colError, "%s:%d: duplicate %s: %s",
                         show_filename, linenr, ip.getName(), msg);
            db.hasErrors = true;
        } else
        if (strcmp(match, msg) != 0) {
            color_print2(db.output, colError, "%s:%d: wrong %s: %s",
                         show_filename, linenr, ip.getName(), msg);
            color_print2(db.output, colError, "     expected: %s", match);
            db.hasErrors = true;
        }
        iter.setFound();
        return;
    }
    if (ip != db.notes) {   // ignore unexpected notes
        color_print2(db.output, colError, "%s:%d: unexpected %s: %s",
                     show_filename, linenr, ip.getName(), msg);
        db.hasErrors = true;
    }
}

public fn void Db.checkIssues(Db* db, Issues* ip) {
    for (issues.Iter iter = ip.getIter(); iter.more(); iter.next()) {
        if (iter.getFound()) continue;
        char[128] path;
        const char* show_filename = db.getShowName(path, elemsof(path), iter.getFilename());
        color_print2(db.output, colError, "%s:%d: expected %s '%s'",
                     show_filename, iter.getLineNr(), ip.getName(), iter.getMsg());
        db.hasErrors = true;
    }
}

