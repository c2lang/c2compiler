module source_lib_generator;

import build_target { BuildTarget }
import component { Component }
import console;
import constants;
import file_copy { copy_file }
import file_utils { Pathname }
import manifest_writer;

import stdlib { exit, EXIT_FAILURE }
import string { strerror }

public fn void generate(BuildTarget* target,
                        const char* target_name,
                        const char* output_dir,
                        Component* mainComp) {
    // copy files
    mainComp.visitFiles((void*)output_dir, copy_source_file);

    // write manifest
    manifest_writer.write(output_dir, mainComp, constants.manifest_name);
}


fn void copy_source_file(void* arg, const char* filename, u32 src_loc) {
    const char* output_dir = arg;

    Pathname dest.init(output_dir, filename);
    if (dest.error) {
        console.error("filename too long %s: %s", output_dir, filename);
        exit(EXIT_FAILURE);
        return;
    }

    // TODO no need to copy file, just write, since we have contents in SourceMgr
    // dont know SourceMgr file_ids here!
    i32 error;
    if (!copy_file(filename, dest.path, &error)) {
        console.error("cannot copy file to %s: %s", dest.path, strerror(error));
        exit(EXIT_FAILURE);
    }
}

