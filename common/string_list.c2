module string_list;

import string_pool { StringPool }

import stdlib { malloc, free }
import string { memset, memcpy, strcmp }

public type StringList struct {
    StringPool* pool;
    u32* indexes;   // into pool
    u32 count;
    u32 capacity;
}

public fn void StringList.init(StringList* l, StringPool* pool) {
    memset(l, 0, sizeof(StringList));
    l.pool = pool;
    l.resize(16);
}

public fn void StringList.free(StringList* l) {
    free(l.indexes);
    l.indexes = nil;
}

public fn void StringList.clear(StringList* l) {
    l.count = 0;
}

fn void StringList.resize(StringList* l, u32 capacity) {
    l.capacity = capacity;
    u32* indexes2 = malloc(capacity * sizeof(u32));
    if (l.count) {
        memcpy(indexes2, l.indexes, l.count * sizeof(u32));
        free(l.indexes);
    }
    l.indexes = indexes2;
}

public fn void StringList.add(StringList* l, u32 name_idx) {
    if (l.count == l.capacity) l.resize(l.capacity * 2);

    l.indexes[l.count] = name_idx;
    l.count++;
}

// remove an index from the string list
// return number of items removed.
public fn u32 StringList.del(StringList* l, u32 idx) {
    u32 j = 0;
    u32 count = l.count;
    for (u32 i = 0; i < count; i++) {
        if (l.indexes[i] != idx)
            l.indexes[j++] = l.indexes[i];
    }
    l.count = j;
    return count - j;
}

public fn void StringList.addStr(StringList* l, const char* str) {
    l.add(l.pool.addStr(str, true));
}

public fn bool StringList.contains(const StringList* l, const char* name) @(unused) {
    for (u32 i=0; i<l.count; i++) {
        if (strcmp(l.pool.idx2str(l.indexes[i]), name) == 0) return true;
    }
    return false;
}

public fn bool StringList.contains_idx(const StringList* l, u32 idx) {
    for (u32 i=0; i<l.count; i++) {
        if (l.indexes[i] == idx) return true;
    }
    return false;
}

public fn u32 StringList.length(const StringList* l) {
    return l.count;
}

public fn const char* StringList.get(const StringList* l, u32 idx) {
    return l.pool.idx2str(l.indexes[idx]);
}

public fn u32 StringList.get_idx(const StringList* l, u32 idx) {
    return l.indexes[idx];
}

public fn u32* StringList.getData(StringList* l) {
    return l.indexes;
}
