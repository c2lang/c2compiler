module file_utils;

import c_errno { errno, ENAMETOOLONG, EEXIST, EINVAL }
import stdio { vsnprintf }
import stdlib { getenv }
import string { pstrcpy, strerror, strlen }
import sys_stat { Stat, stat, S_IFMT, S_IFREG, S_IFDIR, mkdir }
import unistd { getcwd }

public const u32 Max_path = 512;

public fn const char* get_basename(const char* s) {
    const char* base = s;
    while (*s) {
        if (*s++ == '/') base = s;
    }
    return base;
}

public fn const char* get_extension(const char* s) {
    const char* ext = nil;
    for (; *s; s++) {
        if (*s == '/') ext = nil;
        if (*s == '.') ext = s;
    }
    return ext ? ext : s;
}

// Copy a directory name with truncation and append a / if not empty
fn usize copy_dirname(char* buf, usize size, const char* dir) {
    usize pos = pstrcpy(buf, size, dir);
    if (pos && pos < size && dir[pos - 1] != '/') {
        if (pos + 1 < size) {
            buf[pos] = '/';
            buf[pos + 1] = '\0';
        }
        pos += 1;
    }
    return pos;
}

// construct a path in a buffer from a pathname, a filename and an extension
// if the path fits in the destination array, a pointer to it is returned.
// otherwise the path is truncated, errno is set to ENAMETOOLONG and nil is returned
// both the filename and the extension can be nil or omitted
public fn char* make_path(char* buf, usize size, const char* path, const char* filename = nil, const char* ext = nil) {
    usize pos = 0;
    if (filename) {
        if (*filename != '/') pos = copy_dirname(buf, size, path);
        pos += pstrcpy(buf + pos, size - pos, filename);
        if (ext) pos += pstrcpy(buf + pos, size - pos, ext);
    } else {
        pos = pstrcpy(buf, size, path);
    }
    if (pos < size) return buf;
    errno = ENAMETOOLONG;
    return nil;
}

// construct a path in a buffer from a directory name, a subdirectory name and a filename
// if the path fits in the destination array, a pointer to it is returned.
// otherwise the path is truncated, errno is set to ENAMETOOLONG and nil is returned
fn char* make_path3(char* buf, usize size, const char* dir, const char* subdir, const char* filename) {
    usize pos = 0;
    if (*filename != '/') {
        if (*subdir != '/') pos = copy_dirname(buf, size, dir);
        pos += copy_dirname(buf + pos, size - pos, subdir);
    }
    pos += pstrcpy(buf + pos, size - pos, filename);
    if (pos < size) return buf;
    errno = ENAMETOOLONG;
    return nil;
}

// construct an absolute path in a buffer from a pathname
// prepend home directory if pathname starts with '~/'
// prepend current directory unless pathname starts with '/'
// remove redundant '/./' and squeeze '/xxx/../' occurrences
fn char* make_abs_path(char* buf, usize size, const char* path) {
    usize pos = 0;
    if (*path == '~' && (!path[1] || path[1] == '/')) {
        char *homedir = getenv("HOME");
        if (homedir) {
            pos = pstrcpy(buf, size, homedir);
            path++;
            if (*path && pos && buf[pos - 1] == '/') path++;
            pos = pstrcpy(buf + pos, size - pos, path);
        }
    } else
    if (*path != '/') {
        if (getcwd(buf, size)) {
            pos = strlen(buf);
            if (pos && buf[pos - 1] != '/') {
                pos += pstrcpy(buf + pos, size - pos, "/");
            }
            pos += pstrcpy(buf + pos, size - pos, path);
        }
    }
    if (!pos) {
        pos = pstrcpy(buf, size, path);
    }
    char *p = buf;
    char *q = buf;
    for (;;) {
        if (*p == '/' && p[1] == '.') {
            if (!p[2] || p[2] == '/') {
                // replace '/./' with '/'
                p += 2;
                continue;
            }
            if (p[2] == '.') {
                // replace '/xxx/../' with '/'
                if (!p[3] || p[3] == '/') {
                    while (q > buf && *--q != '/') continue;
                    p += 3;
                    continue;
                }
            }
        }
        if (!(*q++ = *p++)) break;
    }
    if (size > 1 && !*buf) {
        buf[0] = '/';
        buf[1] = '\0';
    }
    return buf;
}

fn char* parent_dir(char* path) {
    // truncate path to its parent directory
    // return pointer past the trailing '/'
    // return nil if no parent directory
    char *tail = nil;
    for (char *p = path; *p; p++) {
        if (*p == '/' && p[1]) tail = p + 1;
    }
    if (tail) *tail = '\0';
    return tail;
}

// returns 0 on success, errno on failure
// create a directory path, OK if exists already
public fn i32 create_path(const char* path) {
    if (!path) {
        errno = EINVAL;
        return -1;
    }
    if (!*path) return 0;
    if (is_dir(path)) return 0;
    char[Max_path] tmp;
    u32 len = 0;
    tmp[len++] = *path++;
    while (len < countof(tmp)) {
        char c = *path++;
        // ignore duplicate and trailing slashes
        if (c == '/' && (tmp[len - 1] == '/' || *path == '\0')) continue;
        // create subdirectory chain if needed
        if (c == '/' || c == '\0') {
            tmp[len] = '\0';
            if (mkdir(tmp, 0777) && errno != EEXIST)
                return errno;
            if (c == '\0')
                return 0;
        }
        tmp[len++] = c;
    }
    return errno = ENAMETOOLONG;
}

public fn bool path_exists(const char* path) {
    Stat statbuf;
    return !stat(path, &statbuf);
}

public fn bool is_file(const char* filename) @(unused) {
    Stat statbuf;
    return !stat(filename, &statbuf) && (statbuf.st_mode & S_IFMT) == S_IFREG;
}

public fn bool is_dir(const char* dirname) @(unused) {
    Stat statbuf;
    return !stat(dirname, &statbuf) && (statbuf.st_mode & S_IFMT) == S_IFDIR;
}

public type Pathname struct @(unused) {
    char[Max_path] path;
    i32 error;
}

public fn bool Pathname.init(Pathname* file, const char* dir, const char* filename = nil, const char* ext = nil) {
    file.error = 0;
    if (!make_path(file.path, countof(file.path), dir, filename, ext)) {
        file.error = ENAMETOOLONG;
        return false;
    }
    return true;
}

public fn bool Pathname.initf(Pathname* file, const char* format @(printf_format), ...) @(unused) {
    va_list args;
    va_start(args, format);
    i32 len = vsnprintf(file.path, countof(file.path), format, args);
    va_end(args);
    if (len < 0) {
        file.error = errno;
        return false;
    }
    if ((u32)len >= countof(file.path)) {
        file.error = ENAMETOOLONG;
        return false;
    }
    file.error = 0;
    return true;
}

public fn bool Pathname.init_subdir(Pathname* file, const char* dir, const char* subdir, const char* filename) @(unused) {
    if (!make_path3(file.path, countof(file.path), dir, subdir, filename)) {
        file.error = errno;
        return false;
    }
    file.error = 0;
    return true;
}

public fn bool Pathname.init_cwd(Pathname* file) @(unused) {
    if (!getcwd(file.path, countof(file.path))) {
        file.error = errno;
        *file.path = '\0';
        return false;
    }
    file.error = 0;
    return true;
}

public fn bool Pathname.init_abs(Pathname* file, const char* path) @(unused) {
    make_abs_path(file.path, countof(file.path), path);
    return true;
}

public fn void Pathname.deinit(Pathname* file) @(unused) {}

public fn const char* Pathname.get_extension(const Pathname* file) @(unused) {
    return get_extension(file.path);
}

public fn const char* Pathname.get_basename(const Pathname* file) @(unused) {
    return get_basename(file.path);
}

public fn const char* Pathname.parent_dir(Pathname* file) @(unused) {
    return parent_dir(file.path);
}

public fn bool Pathname.exists(const Pathname* file) @(unused) {
    return path_exists(file.path);
}

public fn bool Pathname.is_file(const Pathname* file) @(unused) {
    return is_file(file.path);
}

public fn bool Pathname.is_dir(const Pathname* file) @(unused) {
    return is_dir(file.path);
}

public fn bool Pathname.create_path(const Pathname* file) @(unused) {
    return create_path(file.path);
}

public fn const char* Pathname.getError(const Pathname* file) @(unused) {
    return strerror(file.error);
}
