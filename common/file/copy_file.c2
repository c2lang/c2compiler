module file_copy;

import file_buffer { FileBuffer }
import file_utils { Pathname }

public fn bool copy_file(const char* source, const char* dest, i32* errp) {
    // Note: not most optimal yet

    // create required sub-directories in dest
    Pathname tmp.init(dest);
    if (tmp.error) {
        *errp = tmp.error;
        return false;
    }

    const char* base = tmp.get_basename();
    if (base != tmp.path) {
        u32 len = (u32)(base - tmp.path);
        tmp.path[len-1] = '\0';
        if (tmp.create_path()) {
            *errp = tmp.error;
            return false;
        }
    }

    // copy file
    FileBuffer fbuf.init();

    // TODO just open both and copy page-by-page (dont use reader/writer)
    if (!fbuf.loadFile(source) || !fbuf.writeFile(dest)) {
        *errp = fbuf.error;
        fbuf.deinit();
        return false;
    }
    fbuf.deinit();
    return true;
}
