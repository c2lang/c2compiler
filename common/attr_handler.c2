module attr_handler;

import ast { AttrHandlerFn, Decl }
import attr { Attr }
import diagnostics { Diags }
import string_pool { Pool }
import warning_flags { Flags }

import stdlib { calloc, malloc, free }
import string { memcpy }

type Entry struct {
    u32 name;
    AttrHandlerFn func;
    void* arg;
}

public type Handler struct @(opaque) {
    Diags* diags;   // no ownership
    Pool* astPool;
    const Flags* warnings;

    Entry* entries;
    u32 count;
    u32 capacity;
}

public fn Handler* create(Diags* diags,
                          Pool* astPool,
                          const Flags* warnings) {
    Handler* h = calloc(1, sizeof(Handler));
    h.diags = diags;
    h.astPool = astPool;
    h.warnings = warnings;
    return h;
}

public fn void Handler.free(Handler* h) {
    if (h.entries) free(h.entries);
    free(h);
}

public fn bool Handler.register(Handler* h, u32 name, AttrHandlerFn func, void* arg) {
    // TODO check for duplicates

    if (h.count == h.capacity) {
        h.capacity += 2;
        Entry* entries2 = malloc(h.capacity * sizeof(Entry));
        if (h.count) {
            memcpy(entries2, h.entries, h.count * sizeof(Entry));
            free(h.entries);
        }
        h.entries = entries2;
    }

    Entry* e = &h.entries[h.count];
    e.name = name;
    e.func = func;
    e.arg = arg;
    h.count++;
    return true;
}

public fn bool Handler.handle(Handler* h, Decl* d, const Attr* a) {
    for (u32 i=0; i<h.count; i++) {
        Entry* e = &h.entries[i];
        if (e.name == a.name) return e.func(e.arg, d, a);
    }
    if (!h.warnings.no_unknown_attribute) {
        h.diags.warn(a.loc, "unknown attribute '%s'", h.astPool.idx2str(a.name));
    }
    return false;
}

