module build_target;

import file_list { FileList, File }
import src_loc { SrcLoc }
import string_list { StringList }
import string_map { StringMap }
import string_pool { StringPool }
import warning_flags { WarningFlags }

import stdlib { calloc, malloc, free }
import string { memset, memcpy }

public type BackEndKind enum u8 {
    None,
    C,
    IR,
}

public type Kind enum u8 {
    Image,
    Executable,
    StaticLibrary,
    DynamicLibrary,
    SourceLibrary,
}

public fn bool has_dynamic(Kind k) {
    switch (k) {
    case Image:
        return false;
    case Executable:
        return true;
    case StaticLibrary:
        return false;
    case DynamicLibrary:
        return true;
    case SourceLibrary:
        return false;
    }
    return false;
}

public type Plugin struct {
    u32 name; // into pool
    u32 options; // into pool
    SrcLoc loc;
}

public type PluginList struct {
    Plugin* plugins;        // malloc'ed, ownership
    u32 count;
    u32 capacity;
}

public fn void PluginList.init(PluginList* l) {
    memset(l, 0, sizeof(PluginList));
}

public fn void PluginList.free(PluginList* l) {
    free(l.plugins);
}

public fn u32 PluginList.size(const PluginList* l) { return l.count; }

public fn const Plugin* PluginList.get(const PluginList* l, u32 idx) {
    return &l.plugins[idx];
}

public fn void PluginList.add(PluginList* l, u32 name, u32 options, SrcLoc loc) {
    if (l.count == l.capacity) {
        l.capacity = l.capacity ? l.capacity * 2 : 4;
        Plugin* plugins2 = malloc(l.capacity * sizeof(Plugin));
        if (l.count) {
            memcpy(plugins2, l.plugins, l.count * sizeof(Plugin));
            free(l.plugins);
        }
        l.plugins = plugins2;
    }
    Plugin* p = &l.plugins[l.count];
    p.name = name;
    p.options = options;
    p.loc = loc;
    l.count++;
}

public type BuildTarget struct @(opaque) {
    u32 name_idx;       // index into auxPool
    SrcLoc loc;
    WarningFlags warnings;
    Kind kind;

    bool disable_asserts;
    bool no_libc;
    BackEndKind backend;
    bool backend_no_build;
    bool backend_fast;
    bool optional;
    bool disabled;

    StringMap features;
    List libs;
    StringList exports;
    PluginList plugins;

    FileList files;
    FileList asm_files;
}

public fn BuildTarget* BuildTarget.create(u32 name_idx, SrcLoc loc, Kind kind, StringPool* pool) {
    BuildTarget* t = calloc(1, sizeof(BuildTarget));
    t.name_idx = name_idx;
    t.loc = loc;
    t.kind = kind;
    t.features.init(pool);
    t.libs.init();
    t.exports.init(pool);
    t.files.init(8);
    t.asm_files.init(0);
    t.enableWarnings();
    return t;
}

public fn void BuildTarget.free(BuildTarget* t) {
    t.exports.free();
    t.plugins.free();
    t.libs.free();
    t.features.free();
    t.asm_files.free();
    t.files.free();
    free(t);
}

public fn u32 BuildTarget.getNameIdx(const BuildTarget* t) { return t.name_idx; }

public fn void BuildTarget.setNameIdx(BuildTarget* t, u32 name_idx) {
    t.name_idx = name_idx;
}

public fn u32 BuildTarget.numFiles(const BuildTarget* t) { return t.files.getCount(); }

public fn u32 BuildTarget.numAsmFiles(const BuildTarget* t) { return t.asm_files.getCount(); }

public fn const StringMap* BuildTarget.getFeatures(const BuildTarget* t) { return &t.features; }

public fn void BuildTarget.addFeature(BuildTarget* t, u32 feature) {
    t.features.addNameValue(feature, "1");
}

public fn void BuildTarget.removeFeature(BuildTarget* t, u32 feature) {
    t.features.del(feature);
}

public fn void BuildTarget.addPlugin(BuildTarget* t, u32 name, u32 options, SrcLoc loc) {
    t.plugins.add(name, options, loc);
}

public fn const PluginList* BuildTarget.getPlugins(const BuildTarget* t) { return &t.plugins; }


public fn void BuildTarget.disableAsserts(BuildTarget* t) { t.disable_asserts = true; }

public fn bool BuildTarget.hasAsserts(const BuildTarget* t) { return !t.disable_asserts; }

public type Visitor fn void (void* arg, u32 name, Kind kind);

public fn void BuildTarget.visitLibs(const BuildTarget* t, Visitor visitor, void* arg) {
    t.libs.visit(visitor, arg);
}

public fn bool BuildTarget.hasLib(const BuildTarget* t, u32 lib) {
    return t.libs.contains(lib);
}

public fn void BuildTarget.addLib(BuildTarget* t, u32 lib, Kind kind) {
    t.libs.add(lib, kind);
}

public fn void BuildTarget.disableWarnings(BuildTarget* t) {
    t.warnings.clearAll();
}

public fn void BuildTarget.enableWarnings(BuildTarget* t) {
    t.warnings.setAll();
}

public fn const WarningFlags* BuildTarget.getWarnings(const BuildTarget* t) {
    return &t.warnings;
}

public fn WarningFlags* BuildTarget.getWarnings2(BuildTarget* t) {
    return &t.warnings;
}

public fn void BuildTarget.addExport(BuildTarget* t, u32 export) {
    t.exports.add(export);
}

public fn const StringList* BuildTarget.getExports(const BuildTarget* t) { return &t.exports; }

public fn Kind BuildTarget.getKind(const BuildTarget* t) { return t.kind; }

public fn bool BuildTarget.needsMain(const BuildTarget* t) {
    switch (t.kind) {
    case Image:
    case Executable:
        return true;
    case StaticLibrary:
    case DynamicLibrary:
    case SourceLibrary:
        break;
    }
    return false;
}

public fn bool BuildTarget.addFile(BuildTarget* t, u32 filename, SrcLoc loc) {
    return t.files.add(filename, loc);
}

public fn const File* BuildTarget.getFile(const BuildTarget* t, u32 idx) {
    return t.files.get(idx);
}

public fn bool BuildTarget.addAsmFile(BuildTarget* t, u32 filename, SrcLoc loc) {
    return t.asm_files.add(filename, loc);
}

public fn const File* BuildTarget.getAsmFile(const BuildTarget* t, u32 idx) {
    return t.asm_files.get(idx);
}

public fn void BuildTarget.setNoLibC(BuildTarget* t) {
    t.no_libc = true;
}

public fn bool BuildTarget.getNoLibC(const BuildTarget* t) {
    return t.no_libc;
}

public fn BackEndKind BuildTarget.getBackEnd(const BuildTarget* t) {
    return t.backend;
}

public fn bool BuildTarget.hasBackEnd(const BuildTarget* t) {
    return t.backend != None;
}

public fn void BuildTarget.setBackEnd(BuildTarget* t, BackEndKind kind) {
    t.backend = kind;
}

public fn void BuildTarget.setNoBuild(BuildTarget* t) {
    t.backend_no_build = true;
}

public fn bool BuildTarget.getNoBuild(const BuildTarget* t) {
    return t.backend_no_build;
}

public fn void BuildTarget.setFastBuild(BuildTarget* t) {
    t.backend_fast = true;
}

public fn bool BuildTarget.getFastBuild(const BuildTarget* t) {
    return t.backend_fast;
}

public fn void BuildTarget.setOptional(BuildTarget* t) {
    t.optional = true;
}

public fn bool BuildTarget.getOptional(const BuildTarget* t) {
    return t.optional;
}

public fn void BuildTarget.setDisabled(BuildTarget* t) {
    t.disabled = true;
}

public fn bool BuildTarget.getDisabled(const BuildTarget* t) {
    return t.disabled;
}

