module stmt_list;

import ast { Stmt }

import stdlib { malloc, free }
import string { memcpy, memset }

// Use stack for small lists, heap for larger ones

public const u32 StackSize = 4;

public type StmtList struct {
    u32 count;
    u32 capacity;
    Stmt*[StackSize] stack;
    Stmt** data;
}

public fn void StmtList.init(StmtList* l) {
    memset(l, 0, sizeof(StmtList));
    l.data = l.stack;
    l.capacity = countof(l.stack);
}

public fn void StmtList.clear(StmtList* l) {
    l.count = 0;
}

public fn void StmtList.add(StmtList* l, Stmt* s) {
    if (l.count == l.capacity) {
        l.capacity *= 2;
        Stmt** data2 = malloc(l.capacity * sizeof(Stmt*));
        memcpy(data2, l.data, l.count * sizeof(Stmt*));
        if (l.data != l.stack) free(l.data);
        l.data = data2;
    }
    l.data[l.count] = s;
    l.count++;
}

public fn void StmtList.free(StmtList* l) {
    if (l.data != l.stack) free(l.data);
}

public fn u32 StmtList.size(const StmtList* l) {
    return l.count;
}

public fn Stmt** StmtList.getData(StmtList* l) {
    return l.data;
}

