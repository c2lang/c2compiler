module sdl_image extern "C";

import sdl;

//IMG_InitFlags;
const unsigned INIT_JPG  = 0x00000001;
const unsigned INIT_PNG  = 0x00000002;
const unsigned INIT_TIF  = 0x00000004;
const unsigned INIT_WEBP = 0x00000008;

int init(int flags) @(cname="IMG_Init");
void quit(void) @(cname="IMG_Quit");
sdl.Surface* load(const char* file) @(cname="IMG_Load");
int setColorKey(sdl.Surface* surface, int flag, u32 key) @(cname="SDL_SetColorKey");

