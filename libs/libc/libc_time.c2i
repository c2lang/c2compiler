module libc_time extern "C";

struct Tm {
    int tm_sec;    /* Seconds (0-60) */
    int tm_min;    /* Minutes (0-59) */
    int tm_hour;   /* Hours (0-23) */
    int tm_mday;   /* Day of the month (1-31) */
    int tm_mon;    /* Month (0-11) */
    int tm_year;   /* Year - 1900 */
    int tm_wday;   /* Day of the week (0-6, Sunday = 0) */
    int tm_yday;   /* Day in the year (0-365, 1 Jan = 0) */
    int tm_isdst;  /* Daylight saving time */

    long tm_gmtoff;
    const char* tm_zone;
}

typedef long time_t;

time_t time(time_t* tloc);

char* asctime(const Tm* tm);
char* asctime_r(const Tm* tm, char* buf);

char* ctime(const time_t* timep);
char* ctime_r(const time_t* timep, char* buf);

time_t* gmtime(const time_t* timep);
time_t* gmtime_r(const time_t* timep, Tm* result);

Tm* localtime(const time_t* timep);
Tm* localtime_r(const time_t* timep, Tm* result);

time_t mktime(Tm* tm);

size_t strftime(char* s, size_t max, const char* format, const Tm* tm);

typedef long clock_t;
clock_t clock(void);

#if SYSTEM_FREEBSD
const i64 CLOCKS_PER_SEC = 128;
#elif SYSTEM_OPENBSD
const i64 CLOCKS_PER_SEC = 100;
#else
const i64 CLOCKS_PER_SEC = 1000000;
#endif
