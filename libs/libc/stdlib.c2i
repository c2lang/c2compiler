int system(const char* command);
char* realpath(const char* name, char* resolved);
char* mktemp(char* tpl);

void* bsearch(const void* key, const void* base, size_t nmemb, size_t size, fn i32(const void*, const void*) compare);
void qsort(void* base, size_t nmemb, size_t size, fn i32(const void*, const void*) compar);

int abs(int x) @(pure);
long labs(long x) @(pure);
div_t div(int numer, int denom);
ldiv_t ldiv(long numer, long denom);

