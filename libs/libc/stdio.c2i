char* getsn(char* buf, size_t len) {
    size_t i = 0;
    while (i + 1 < len) {
        int c = fgetc(stdin);
        if (c == EOF) {
            if (i == 0) return nil;
            break;
        }
        if (c == '\n') break;
        buf[i++] = (char)c;
    }
    if (len == 0) {
        if (feof(stdin)) return nil;
    } else {
        buf[i] = '\0';
    }
    return buf;
}
