module c2recipe;

import build_target { BuildTarget, PluginList }
import source_mgr { SourceMgr }
import src_loc { SrcLoc }
import string_pool { StringPool }

import stdlib { malloc, calloc, free }
import string { memcpy }

public type Recipe struct @(opaque) {
    StringPool* pool;
    SourceMgr* sm;

    BuildTarget** targets;
    u32 num_targets;
    u32 max_targets;

    PluginList plugins;
    bool use_color;
}

public fn Recipe* Recipe.create(SourceMgr* sm, StringPool* pool, bool use_color) {
    Recipe* r = calloc(1, sizeof(Recipe));
    r.sm = sm;
    r.pool = pool;
    r.use_color = use_color;
    r.max_targets = 4;
    r.targets = calloc(r.max_targets, sizeof(BuildTarget*));
    r.plugins.init();
    return r;
}

public fn void Recipe.free(Recipe* r) {
    for (u32 i=0; i<r.num_targets; i++) {
        r.targets[i].free();
    }
    free(r.targets);
    r.plugins.free();
    free(r);
}

// always global
fn void Recipe.addPlugin(Recipe* r, u32 name, u32 options, SrcLoc loc) {
    r.plugins.add(name, options, loc);
}

public fn BuildTarget* Recipe.addTarget(Recipe* r, u32 name, SrcLoc loc, build_target.Kind kind) {
    // search for duplicates
    for (u32 i = 0; i < r.num_targets; i++) {
        BuildTarget* t = r.targets[i];
        if (t.getNameIdx() == name) return nil;
    }

    if (r.num_targets == r.max_targets) {
        r.max_targets *= 2;
        BuildTarget** targets2 = malloc(r.max_targets * sizeof(BuildTarget*));
        memcpy(targets2, r.targets, r.num_targets * sizeof(BuildTarget*));
        free(r.targets);
        r.targets = targets2;
    }
    BuildTarget* t = BuildTarget.create(name, loc, kind, r.pool);
    r.targets[r.num_targets] = t;
    r.num_targets++;
    return t;
}

public fn bool Recipe.parse(Recipe* r, i32 file_id) {
    return Parser.parse(r, r.pool, r.sm, file_id, r.use_color);
}

public fn u32 Recipe.numTargets(const Recipe* r) { return r.num_targets; }

public fn BuildTarget* Recipe.getTarget(const Recipe* r, u32 idx) {
    return r.targets[idx];
}

public fn const PluginList* Recipe.getPlugins(const Recipe* r) {
    return &r.plugins;
}

