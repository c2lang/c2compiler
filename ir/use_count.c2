module ir_context;

import ir { * }

// Static use count of functions.
//
// A use is a reference to the function in the body of another (live) function (a call, taking
// the address) or in the initializer of a global. Exported functions have an implicit extra use.
// When a call is inlined, the use count of the callee is decremented. A function whose use count
// drops to zero is dead: it is not processed or generated anymore and its own references to
// other functions are released as well.

fn Symbol* IrContext.getFunctionSymbol(IrContext* c, Ref r) {
    if (r.getKind() != RefKind.Symbol) return nil;
    Symbol* s = c.symbols.get((u32)r.value);
    if (!s.is_function) return nil;
    return s;
}

fn void IrContext.countRef(IrContext* c, Ref r) {
    Symbol* s = c.getFunctionSymbol(r);
    if (s && s.f.info) s.f.info.use_count++;
}

// Calls func for every reference in the (non-removed) instructions of fi
fn void IrContext.countRefs(IrContext* c, const FunctionInfo* fi) {
    u32 num_instr = fi.instructions.getCount();
    for (u32 i = 0; i < num_instr; i++) {
        const Instr* ii = fi.instructions.get(i);
        if (ii.isNone()) continue;
        if (ii.isPhi()) {
            const PhiClause* clauses = fi.phis.get((u32)ii.args[0].value);
            for (u32 p = 0; p < (u32)ii.args[1].value; p++) c.countRef(clauses[p].ref);
            continue;
        }
        c.countRef(ii.args[0]);
        c.countRef(ii.args[1]);
    }
}

// Recalculates the use counts of all functions, based on the live functions.
fn void IrContext.countUses(IrContext* c) {
    u32 num_symbols = c.symbols.getCount();
    for (u32 i = 1; i < num_symbols; i++) {
        Symbol* s = c.symbols.get(i);
        if (!s.is_function || !s.f.info) continue;
        s.f.info.use_count = s.is_external ? 1 : 0;
    }
    for (u32 i = 1; i < num_symbols; i++) {
        const Symbol* s = c.symbols.get(i);
        if (s.is_dead) continue;
        if (s.is_function) {
            if (s.f.info) c.countRefs(s.f.info);
        } else {
            const InitValue* values = c.init_values.get(s.g.init_value_idx);
            for (u32 j = 0; j < s.g.init_value_count; j++) {
                if (values[j].getKind() != InitValueKind.Symbol) continue;
                Ref r.init(RefKind.Symbol, values[j].value);
                c.countRef(r);
            }
        }
    }
}

// The function is not used anymore: release the references from its body
fn void IrContext.killFunction(IrContext* c, Symbol* s) {
    s.is_dead = 1;
    const FunctionInfo* fi = s.f.info;
    if (!fi) return;

    u32 num_instr = fi.instructions.getCount();
    for (u32 i = 0; i < num_instr; i++) {
        const Instr* ii = fi.instructions.get(i);
        if (ii.isNone()) continue;
        if (ii.isPhi()) {
            const PhiClause* clauses = fi.phis.get((u32)ii.args[0].value);
            for (u32 p = 0; p < (u32)ii.args[1].value; p++) c.releaseRef(clauses[p].ref);
            continue;
        }
        c.releaseRef(ii.args[0]);
        c.releaseRef(ii.args[1]);
    }
}

fn void IrContext.releaseRef(IrContext* c, Ref r) {
    Symbol* s = c.getFunctionSymbol(r);
    if (s) c.releaseUse(s);
}

// Decrements the use count, kills the function when it is not used anymore
fn void IrContext.releaseUse(IrContext* c, Symbol* s) {
    if (s.is_dead || !s.f.info) return;     // no body for external declarations
    FunctionInfo* fi = s.f.info;
    assert(fi.use_count != 0);
    fi.use_count--;
    if (fi.use_count == 0) c.killFunction(s);
}

// Kills all functions without uses
fn void IrContext.pruneUnused(IrContext* c) {
    u32 count = c.functions.getCount();
    const u32* ids = c.functions.getFrom(0);
    for (u32 i = 0; i < count; i++) {
        Symbol* s = c.symbols.get(ids[i]);
        if (!s.is_dead && s.f.info.use_count == 0) c.killFunction(s);
    }
}

// true if the function refers to other functions (calls or addresses)
fn bool IrContext.hasFunctionRefs(IrContext* c, const FunctionInfo* fi) {
    u32 num_instr = fi.instructions.getCount();
    for (u32 i = 0; i < num_instr; i++) {
        const Instr* ii = fi.instructions.get(i);
        if (ii.isNone()) continue;
        if (ii.isPhi()) {
            const PhiClause* clauses = fi.phis.get((u32)ii.args[0].value);
            for (u32 p = 0; p < (u32)ii.args[1].value; p++) {
                if (c.getFunctionSymbol(clauses[p].ref)) return true;
            }
            continue;
        }
        if (c.getFunctionSymbol(ii.args[0])) return true;
        if (c.getFunctionSymbol(ii.args[1])) return true;
    }
    return false;
}
