module ast;

import ast_context { Context }
import string_buffer { Buf }
import src_loc { SrcLoc }

public const u32 LHS = 0x01;
public const u32 RHS = 0x02;

public type BinaryOpcode enum u8 (public const char* const name,
                                  public const u32 side @(unused)) {
    Multiply       : { "*",   RHS },
    Divide         : { "/",   RHS },
    Remainder      : { "%",   RHS },
    Add            : { "+",   RHS },
    Subtract       : { "-",   RHS },
    ShiftLeft      : { "<<",  RHS },
    ShiftRight     : { ">>",  RHS },
    LessThan       : { "<",   RHS },
    GreaterThan    : { ">",   RHS },
    LessEqual      : { "<=",  RHS },
    GreaterEqual   : { ">=",  RHS },
    Equal          : { "==",  RHS },
    NotEqual       : { "!=",  RHS },
    And            : { "&",   RHS },
    Xor            : { "^",   RHS },
    Or             : { "|",   RHS },
    LAnd           : { "&&",  RHS },
    LOr            : { "||",  RHS },
    // keep these here we check for >= Assign to determine if we need an rvalue of lhs
    Assign         : { "=",   LHS },
    MulAssign      : { "*=",  LHS|RHS },
    DivAssign      : { "/=",  LHS|RHS },
    RemAssign      : { "%=",  LHS|RHS },
    AddAssign      : { "+=",  LHS|RHS },
    SubAssign      : { "-=",  LHS|RHS },
    ShlAssign      : { "<<=", LHS|RHS },
    ShrAssign      : { ">>=", LHS|RHS },
    AndAssign      : { "&=",  LHS|RHS },
    XorAssign      : { "^=",  LHS|RHS },
    OrAssign       : { "|=",  LHS|RHS },
}

public fn bool BinaryOpcode.isComparison(BinaryOpcode opcode) {
    return opcode >= LessThan && opcode <= NotEqual;
}

type BinaryOperatorBits struct {
    u32 : NumExprBits;
    u32 : 2;
    BinaryOpcode kind : 5;
}

public type BinaryOperator struct @(opaque) {
    Expr base;
    Expr* lhs;
    Expr* rhs;
}

public fn BinaryOperator* BinaryOperator.create(Context* c, SrcLoc loc, BinaryOpcode kind, Expr* lhs, Expr* rhs) {
    BinaryOperator* e = c.alloc(sizeof(BinaryOperator));
    e.base.init(BinaryOperator, loc, 0, 0, kind >= Assign, RValue);
    e.base.base.binaryOperatorBits.kind = kind;
    e.lhs = lhs;
    e.rhs = rhs;
#if AstStatistics
    Stats.addExpr(BinaryOperator, sizeof(BinaryOperator));
#endif
    return e;
}

fn Expr* BinaryOperator.instantiate(BinaryOperator* e, Instantiator* inst) {
    return (Expr*)BinaryOperator.create(inst.c, e.base.base.loc, e.getOpcode(), e.lhs.instantiate(inst), e.rhs.instantiate(inst));
}

public fn BinaryOpcode BinaryOperator.getOpcode(const BinaryOperator* e) {
    return e.base.base.binaryOperatorBits.kind;
}

public fn Expr* BinaryOperator.getLHS(const BinaryOperator* e) { return e.lhs; }
public fn Expr** BinaryOperator.getLHS2(BinaryOperator* e) { return &e.lhs; }

public fn Expr* BinaryOperator.getRHS(const BinaryOperator* e) { return e.rhs; }
public fn Expr** BinaryOperator.getRHS2(BinaryOperator* e) { return &e.rhs; }

public fn const char* BinaryOperator.getOpcodeStr(const BinaryOperator* e) {
    return e.getOpcode().name;
}

fn SrcLoc BinaryOperator.getStartLoc(const BinaryOperator* e) {
    return e.getLHS().getStartLoc();
}

fn SrcLoc BinaryOperator.getEndLoc(const BinaryOperator* e) {
    return e.getRHS().getEndLoc();
}

fn void BinaryOperator.print(const BinaryOperator* e, Buf* out, u32 indent) {
    e.base.printKind(out, indent);
    e.base.printTypeBits(out);
    out.space();
    out.color(col_Value);
    out.add(e.getOpcode().name);
    out.newline();

    e.lhs.print(out, indent + 1);
    e.rhs.print(out, indent + 1);
}

fn void BinaryOperator.printLiteral(const BinaryOperator* e, Buf* out) {
    e.lhs.printLiteral(out);
    out.space();
    out.add(e.getOpcode().name);
    out.space();
    e.rhs.printLiteral(out);
}

