module ast;

import ast_context { Context }
import string_buffer { Buf}
import src_loc { SrcLoc }

public type ImplicitCastKind enum u8 (const char* const name) {
    ArrayToPointerDecay : { "ArrayToPointerDecay" },
    LValueToRValue      : { "LValueToRValue" },
    PointerToBoolean    : { "PointerToBoolean" },
    PointerToInteger    : { "PointerToInteger" },
    IntegralCast        : { "IntegralCast" },
    BitCast             : { "BitCast" },    // pointer conversion (char* -> i32*, or void* -> FunctionPtr)
}

type ImplicitCastBits struct {
    u32 : NumExprBits;
    u32 : 2;
    ImplicitCastKind kind : 3;
}

public type ImplicitCastExpr struct @(opaque) {
    Expr base;
    Expr* inner;
}

public fn ImplicitCastExpr* ImplicitCastExpr.create(Context* c, SrcLoc loc, ImplicitCastKind kind, Expr* inner) {
    ImplicitCastExpr* e = c.alloc(sizeof(ImplicitCastExpr));
    e.base.init(ImplicitCast, loc, 0, 0, inner.hasEffect(), RValue);
    e.base.base.implicitCastBits.kind = kind;
    e.inner = inner;
    e.base.copyConstantFlags(inner);
    switch (kind) {
    case ArrayToPointerDecay:
        e.base.copyValType(inner);
        e.base.base.exprBits.is_ctv = false;
        break;
    case LValueToRValue:
        e.base.base.exprBits.is_ctc = false;
        break;
    case PointerToBoolean:
        e.base.copyValType(inner);
        break;
    case PointerToInteger:
        e.base.copyValType(inner);
        break;
    case IntegralCast:
        e.base.copyValType(inner);
        break;
    case BitCast:
        e.base.base.exprBits.is_ctc = false;
        break;
    }
#if AstStatistics
    Stats.addExpr(ImplicitCast, sizeof(ImplicitCastExpr));
#endif
    return e;
}

public fn ImplicitCastKind ImplicitCastExpr.getKind(const ImplicitCastExpr* e) {
    return e.base.base.implicitCastBits.kind;
}

public fn bool ImplicitCastExpr.isArrayToPointerDecay(const ImplicitCastExpr* e) {
    return e.getKind() == ArrayToPointerDecay;
}

public fn Expr* ImplicitCastExpr.getInner(const ImplicitCastExpr* e) { return e.inner; }

fn SrcLoc ImplicitCastExpr.getStartLoc(const ImplicitCastExpr* e) {
    return e.getInner().getStartLoc();
}

fn SrcLoc ImplicitCastExpr.getEndLoc(const ImplicitCastExpr* e) {
    return e.getInner().getEndLoc();
}

fn void ImplicitCastExpr.printLiteral(const ImplicitCastExpr* e, Buf* out) {
    e.inner.printLiteral(out);
}

fn void ImplicitCastExpr.print(const ImplicitCastExpr* e, Buf* out, u32 indent) {
    e.base.printKind(out, indent);
    e.base.printTypeBits(out);
    out.space();
    out.color(col_Calc);
    out.add(e.getKind().name);
    out.newline();
    e.inner.print(out, indent + 1);
}

