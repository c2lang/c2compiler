module list;

public type Element struct {
    Element* prev;
    Element* next;
}

public fn void Element.init(Element* src) {
    src.prev = src;
    src.next = src;
}

public fn void Element.addTail(Element* src, Element* item) {
    assert(!item.next && !item.prev);
    Element* old_tail = src.prev;
    src.prev = item;
    item.next = src;
    item.prev = old_tail;
    old_tail.next = item;
}

public fn void Element.addFront(Element* src, Element* item) {
    assert(!item.next && !item.prev);
    Element* old_head = src.next;
    old_head.prev = item;
    item.next = old_head;
    item.prev = src;
    src.next = item;
}

public fn Element* Element.popFront(Element* item) {
    return item.next.detach();
}

public fn Element* Element.detach(Element* item) {
    Element* prev = item.prev;
    Element* next = item.next;
    prev.next = next;
    next.prev = prev;
    item.next = item.prev = nil;
    return item;
}

public fn u64 Element.size(const Element* src) {
    u64 count = 0;
    Element* node = src.next;
    while (node != src) {
        count++;
        node = node.next;
    }
    return count;
}

public fn bool Element.isEmpty(const Element* src) {
    return src.next == src;
}

public fn void Element.move(Element* src, Element* dest) {
    // TODO seems bogus if `src == dest` or if `node == dest`
    Element* node = src.next;
    while (node != src) {
        Element* next = node.next;
        dest.addTail(node.detach());
        node = next;
    }
}

